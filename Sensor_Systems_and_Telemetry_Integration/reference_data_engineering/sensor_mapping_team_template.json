{
  "_comment": "Source profiles map ANY input format onto the canonical schema. Adding official NASA data = adding/enabling a profile here. The declared_data_source is set by a human in this file, never inferred from file contents. Allowed: synthetic | real_nasa | unknown.",
  "pipeline_settings": {
    "strict_provenance": true,
    "allow_mixed_sources": false,
    "anomaly_window_s": 5.0,
    "anomaly_robust_z_threshold": 8.0,
    "anomaly_min_window_points": 5,
    "timestamp_gap_factor": 3.0,
    "missing_value_strategy": "flag_only",
    "ml_test_fraction": 0.25,
    "ml_random_seed": 42,
    "ml_split_group": "run_id",
    "ml_include_suspect": false,
    "derived_rolling_window_s": 5.0,
    "derived_baseline_window_s": 5.0
  },
  "profiles": {
    "synthetic_mock_canonical": {
      "enabled": true,
      "description": "Output of src/mock_generator.py, already in canonical long format.",
      "format": "canonical_long",
      "input_files": ["data/mock/mock_sensor_readings.csv"],
      "metadata_file": "data/mock/mock_experiment_metadata.csv",
      "declared_data_source": "synthetic",
      "source_reference": "Generated by src/mock_generator.py (see data/mock/generation_manifest.json)"
    },

    "example_external_wide_csv": {
      "enabled": true,
      "description": "DEMONSTRATION ONLY. A synthetic file written in an unfamiliar 'lab export' style (wide columns, imperial/mixed units, local clock time). Shows how a new format is mapped without code changes. It is NOT NASA data.",
      "format": "wide",
      "input_files": ["data/raw/sample_external/example_lab_format.csv"],
      "declared_data_source": "synthetic",
      "source_reference": "Hand-made demo file shipped with this repository",
      "csv_options": {"comment": "#"},
      "experiment_id": {"static": "SYN-EXT-DEMO-001"},
      "run_id": {"column": "Trial", "template": "{experiment_id}-R{value:02d}"},
      "elapsed_time": {"column": "Time [ms]", "unit": "ms"},
      "timestamp": {"column": "Clock (local)", "timezone": "America/Chicago", "format": "%m/%d/%Y %H:%M:%S.%f"},
      "columns": {
        "TC-1 (degC)":      {"sensor_id": "TEMP_GAS_01",     "original_unit": "degC"},
        "P_chamber (psia)": {"sensor_id": "PRES_CHAMBER_01", "original_unit": "psi"},
        "O2 frac":          {"sensor_id": "O2_CHAMBER_01",   "original_unit": "fraction"},
        "CO (%)":           {"sensor_id": "CO_CHAMBER_01",   "original_unit": "vol%"}
      },
      "missing_markers": ["", "NaN", "nan", "-999", "N/A", "ERR"],
      "experiment_metadata": {
        "experiment_name": "Demo: unfamiliar external CSV format (synthetic)",
        "experiment_type": "synthetic_adapter_demonstration",
        "gravity_environment": "not_applicable_synthetic",
        "gravity_level": null,
        "fuel_type": "PLACEHOLDER_unspecified",
        "oxidizer_type": "PLACEHOLDER_unspecified",
        "chamber_conditions": "Not applicable - synthetic demonstration file",
        "dataset_status": "synthetic_demo",
        "notes": "Exists only to test the column-mapping adapter."
      }
    },

    "nasa_psi_TEMPLATE": {
      "enabled": false,
      "description": "TEMPLATE for the official NASA PSI release (expected Nov 13). Copy this block per experiment, rename it, fill it from the official documentation, then set enabled=true. Remove any sensor that the experiment does not actually record - never manufacture measurements.",
      "format": "wide",
      "input_files": ["data/raw/nasa/<EXPERIMENT_FOLDER>/<FILE>.csv"],
      "declared_data_source": "real_nasa",
      "source_reference": "TO_FILL: PSI experiment page URL / DOI / dataset citation exactly as published by NASA",
      "csv_options": {},
      "experiment_id": {"static": "TO_FILL_use_official_NASA_identifier"},
      "run_id": {"column": "TO_FILL_or_use_static", "template": "{experiment_id}-R{value}"},
      "elapsed_time": {"column": "TO_FILL", "unit": "s"},
      "timestamp": {"column": null, "timezone": "UTC", "format": null},
      "columns": {
        "TO_FILL_original_column_name": {"sensor_id": "TEMP_GAS_01", "original_unit": "TO_FILL"}
      },
      "missing_markers": [""],
      "experiment_metadata": {
        "experiment_name": "TO_FILL",
        "experiment_type": "TO_FILL",
        "gravity_environment": "TO_FILL",
        "gravity_level": null,
        "fuel_type": "TO_FILL",
        "oxidizer_type": "TO_FILL",
        "chamber_conditions": "TO_FILL",
        "dataset_status": "real_nasa_unvalidated",
        "notes": "TO_FILL"
      }
    }
  }
}
