# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# S3 location of the NASA PSI files you mirror (ask Wania for the exact bucket/prefix)
PSI_S3_BUCKET=your-psi-bucket-name
PSI_S3_PREFIX=SAME/
AWS_REGION=us-east-1

# Set to 1 for public buckets (no AWS credentials needed)
PSI_S3_ANONYMOUS=1

# Only needed when PSI_S3_ANONYMOUS=0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
